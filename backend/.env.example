# ============================================================
# REQUIRED ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# Production: inject these via your platform's secret manager
# (AWS Secrets Manager, GCP Secret Manager, Railway, Render etc.)
# ============================================================

# Database
DB_URL=jdbc:postgresql://<host>:<port>/<database>
DB_USERNAME=<your_db_username>
DB_PASSWORD=<your_db_password>

# JWT
# Generate a secure secret with: openssl rand -base64 32
JWT_SECRET=<your_base64_encoded_secret_min_32_bytes>
JWT_EXPIRATION_MS=86400000

# App
SERVER_PORT=8080

# Admin seeder
ADMIN_EMAIL=<EMAIL>
ADMIN_PASSWORD=<PASSWORD>

# Anthropic — AI travel assistant (optional)
# Leave blank to disable. The app starts either way; with no key the assistant
# reports itself unavailable and the frontend hides it. Unlike every other
# integration here, this one bills per request.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=8192