# ============================================================
# REQUIRED ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# Production: inject these via your platform's secret manager
# (AWS Secrets Manager, GCP Secret Manager, Railway, Render etc.)
# ============================================================

# Database
DB_URL=jdbc:postgresql://<host>:<port>/<database>
DB_USERNAME=<your_db_username>
DB_PASSWORD=<your_db_password>

# JWT
# Generate a secure secret with: openssl rand -base64 32
JWT_SECRET=<your_base64_encoded_secret_min_32_bytes>
JWT_EXPIRATION_MS=86400000

# App
SERVER_PORT=8080

# Admin seeder
ADMIN_EMAIL=<EMAIL>
ADMIN_PASSWORD=<PASSWORD>

# Anthropic — AI travel assistant (optional)
# Leave blank to disable. The app starts either way; with no key the assistant
# reports itself unavailable and the frontend hides it. Unlike every other
# integration here, this one bills per request.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=8192

# Password reset email (optional)
# Compose points these at the bundled mailpit catcher; read the mail at
# http://localhost:8025. Nothing leaves your machine, so this is safe to demo.
# Leave SPRING_MAIL_HOST blank to write the link to the server log instead,
# which is what happens when the API runs outside Compose.
# For a real provider: smtp.resend.com, port 587, auth and starttls true, plus
# SPRING_MAIL_USERNAME / SPRING_MAIL_PASSWORD and a domain you have verified.
SPRING_MAIL_HOST=mail
SPRING_MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@skyair.example

# Where the app is reachable in a browser. Reset links are built from this.
APP_BASE_URL=http://localhost:5173